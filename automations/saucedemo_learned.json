          "input_text": "{password[0]}"
        }
      }
    },
    {
      "type": "action_node",
      "interaction_action": {
        "click_element": {
          "command": "locator(\"input[data-test='login-button']\").first",
          "prompt_instructions": "Click the 'Login' submit button"
        }
      }
    },
    {
      "type": "action_node",
