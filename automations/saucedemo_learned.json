      "interaction_action": {
        "input_text": {
          "command": "locator(\"input[data-test='firstName']\").first",
          "prompt_instructions": "Type {first_name[0]} into the 'First Name' text box",
          "input_text": "{first_name[0]}"
        }
      }
    },
    {
      "type": "action_node",
      "interaction_action": {
        "input_text": {
          "command": "locator(\"input[data-test='lastName']\").first",
